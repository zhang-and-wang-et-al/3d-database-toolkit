<UserControl x:Class="SceneInspector.Panels.ReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SceneInspector">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="ReviewTitle" Text="No optimization run yet" Style="{StaticResource Title}" />
                <TextBlock x:Name="ReviewSub" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Run passes in the Optimize tab (F5). Every changed geometry is listed here with a damage check." />
                <WrapPanel x:Name="ReviewDeltas" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Left" local:Ui.Icon="&#xE7B3;" Content="Show in 3D" Click="OnShowChange" Margin="0,0,6,0"
                    ToolTip="Before / after of the selected change (double click)" />
            <Button DockPanel.Dock="Left" local:Ui.Icon="&#xE72C;" Content="Check Again" Click="OnCheckSelectedChanges"
                    ToolTip="Run the damage check again for the selected changes" />
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       Text="Shape changing passes are checked for holes, flipped faces and surface deviation." />
        </DockPanel>
        <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Run log" Margin="0,4,0,0" IsExpanded="True">
            <TextBox x:Name="OptLog" Style="{StaticResource Mono}" TextWrapping="Wrap" Height="170" Margin="0,4,0,0"
                     Background="{DynamicResource Window}" />
        </Expander>
        <!-- undo history: click a step to undo / redo up to it -->
        <Expander x:Name="HistoryExpander" DockPanel.Dock="Bottom" Header="History" Margin="0,8,0,0" IsExpanded="True"
                  ToolTip="Every undoable step, then the checkpoints on disk (grey); click a step to undo or redo up to it, a grey row to reload the database at that state">
            <StackPanel Margin="0,4,0,0">
                <Button x:Name="ExportStatesButton" AutomationProperties.AutomationId="ExportStatesButton" Style="{StaticResource Button.Ghost}"
                        Content="Export States…" HorizontalAlignment="Left" Margin="0,0,0,4" IsEnabled="False" Click="OnExportStates"
                        ToolTip="Write the unchanged database and the checkpoint states that led to the current one as numbered folders (state_01_…) into the folder you choose, to load one after the other in the renderer" />
                <!-- where the checkpoints are (or why one could not be written), then the undo cap note -->
                <TextBlock x:Name="HistoryCap" Style="{StaticResource Muted}" FontSize="{DynamicResource Font.Small}" Margin="4,0,0,4"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <ListView x:Name="HistoryList" SelectionMode="Single" MaxHeight="190" KeyDown="OnHistoryKey"
                          local:Ui.EmptyText="No steps yet.">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="Foreground" Value="{Binding Foreground}" />
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <EventSetter Event="MouseLeftButtonUp" Handler="OnHistoryClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="220">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Step" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE76C;" FontFamily="{DynamicResource Font.Icons}" FontSize="10" Width="16"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="160">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Scope" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Scope}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Time" Width="76" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Δ Triangles" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Tris}" Style="{StaticResource Num}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Δ Draws" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Draws}" Style="{StaticResource Num}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Expander>
        <ListView x:Name="ChangeList" SelectionMode="Extended" MouseDoubleClick="OnShowChange"
                  local:Ui.EmptyText="Nothing changed yet.&#x0a;Run passes in the Optimize tab (F5) or fix a finding to see the changes here."
                  local:Ui.FillLastColumn="170">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="84">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Check" ToolTip="Result of the damage check" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Background="{Binding RiskTint}">
                                    <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskBrush}" FontSize="{DynamicResource Font.Small}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Node" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Path}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Pass" Width="104">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Pass}" ToolTip="{Binding Pass}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Triangles" HorizontalContentAlignment="Right" ToolTip="Before → after" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Tris}" Style="{StaticResource Num}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Vertices" HorizontalContentAlignment="Right" ToolTip="Before → after" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding Verts}" Style="{StaticResource Num}" /></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- takes the width the others leave (Ui.FillLastColumn); the unit chip stays whole, the check text trims -->
                    <GridViewColumn Header="Quality Check" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Background="{DynamicResource Sev.Med.Tint}" Margin="0,0,8,0"
                                            Visibility="{Binding UnitVisibility}"
                                            ToolTip="The pass left this geometry without a texture unit it had before (detail / light map gone)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource Font.Icons}" FontSize="10" Margin="0,1,5,0"
                                                       Foreground="{DynamicResource Sev.Med}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding UnitDelta}" Foreground="{DynamicResource Sev.Med}" FontWeight="SemiBold"
                                                       FontSize="{DynamicResource Font.Small}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Check}" ToolTip="{Binding Check}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
