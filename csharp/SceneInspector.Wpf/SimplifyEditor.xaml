<UserControl x:Class="SceneInspector.SimplifyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The one simplify record (R2-D3): target (within a distance / keep a share), strategy (R2-D4), advanced settings.
         Used by the Try strip (TryEditor) and the Optimize tab's simplify pass (OptEditor); MainWindow keeps them in step. -->
    <StackPanel>
        <WrapPanel>
            <!-- no GroupName: the two editors live in one window; the radio buttons group by their panel -->
            <Border Style="{StaticResource SegmentBar}" Margin="0,2,12,2" VerticalAlignment="Center"
                    ToolTip="Within: stay within a distance of the original surface; the triangle count is the result. Keep %: keep a share of the triangles.">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TargetWithin" AutomationProperties.AutomationId="TargetWithin" Style="{StaticResource Segment}" Content="Within"
                                 IsChecked="True" Checked="OnTargetChanged" />
                    <RadioButton x:Name="TargetKeep" AutomationProperties.AutomationId="TargetKeep" Style="{StaticResource Segment}" Content="Keep %"
                                 Checked="OnTargetChanged" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="WithinRow" Orientation="Horizontal" Margin="0,2,12,2">
                <TextBox x:Name="WithinBox" AutomationProperties.AutomationId="WithinBox" Width="110" VerticalAlignment="Center"
                         TextChanged="OnWithinText" KeyDown="OnWithinKey" />
                <Slider x:Name="WithinSlider" AutomationProperties.AutomationId="WithinSlider" Minimum="0.1" Maximum="5" Value="0.5"
                        SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="130" Margin="8,0" VerticalAlignment="Center"
                        ToolTip="0.1 to 5 % of the object's size" ValueChanged="OnWithinSlider" PreviewMouseLeftButtonUp="OnSliderReleased" />
                <TextBlock x:Name="WithinMetres" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="KeepRow" Orientation="Horizontal" Margin="0,2,12,2" Visibility="Collapsed">
                <TextBlock Text="Keep" VerticalAlignment="Center" />
                <Slider x:Name="RatioSlider" AutomationProperties.AutomationId="RatioSlider" Minimum="5" Maximum="95" Value="50" Width="150" Margin="8,0"
                        VerticalAlignment="Center" ValueChanged="OnRatioChanged" PreviewMouseLeftButtonUp="OnSliderReleased" />
                <TextBlock x:Name="RatioLabel" Text="50 %" Width="36" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="of the triangles" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ResultBlock" AutomationProperties.AutomationId="ResultText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,12,2" />
            <CheckBox x:Name="AutoTry" Content="Update on release" IsChecked="True" Margin="0,2" VerticalAlignment="Center" Visibility="Collapsed"
                      ToolTip="Run the preview when a slider is released" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Strategy" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="StrategyBox" AutomationProperties.AutomationId="StrategyBox" Width="260" SelectionChanged="OnStrategyChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Simplifier" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="EngineBox" AutomationProperties.AutomationId="EngineBox" Width="170" SelectionChanged="OnEngineChanged" />
        </StackPanel>
        <TextBlock x:Name="StrategyHelp" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,3,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <Run x:Name="StrategyHelpText" />
            <Hyperlink Click="OnHelp" ToolTip="Open the README section on the simplify strategies">
                <Hyperlink.Style>
                    <Style TargetType="Hyperlink">
                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Hyperlink.Style>Help</Hyperlink>
        </TextBlock>
        <Expander x:Name="Advanced" AutomationProperties.AutomationId="Advanced" Header="Advanced" Margin="0,4,0,0">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Tile edges" VerticalAlignment="Center" Margin="0,3,12,3" />
                <ComboBox x:Name="BordersBox" Grid.Column="1" Width="230" Margin="0,3" HorizontalAlignment="Left" SelectionChanged="OnAdvancedChanged">
                    <ComboBoxItem Content="Match neighbours (match)" Tag="match" />
                    <ComboBoxItem Content="Keep every edge vertex (lock)" Tag="lock" />
                    <ComboBoxItem Content="Let them slide (slide)" Tag="slide" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Separate parts" VerticalAlignment="Center" Margin="0,3,12,3" />
                <ComboBox x:Name="PartsBox" Grid.Row="1" Grid.Column="1" Width="230" Margin="0,3" HorizontalAlignment="Left" SelectionChanged="OnAdvancedChanged">
                    <ComboBoxItem Content="May merge (merge)" Tag="merge" />
                    <ComboBoxItem Content="Stay separate (keep)" Tag="keep" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="Hard edge above (degrees)" VerticalAlignment="Center" Margin="0,3,12,3" />
                <TextBox x:Name="CreaseBox" Grid.Row="2" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" TextChanged="OnNumberText" />
                <TextBlock Grid.Row="3" Text="New texture size (pixels)" VerticalAlignment="Center" Margin="0,3,12,3" />
                <TextBox x:Name="RebakeBox" Grid.Row="3" Grid.Column="1" Width="80" Margin="0,3" HorizontalAlignment="Left" TextChanged="OnNumberText" />
                <CheckBox x:Name="ProtectOverlays" AutomationProperties.AutomationId="ProtectOverlays" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,3"
                          Content="Keep roads and decals on the ground" IsChecked="True" Checked="OnProtectChanged" Unchecked="OnProtectChanged"
                          ToolTip="Terrain under roads and decals keeps its vertices so they do not float or sink (overlay protection)" />
                <CheckBox x:Name="PruneBox" AutomationProperties.AutomationId="PruneBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,3"
                          Content="Drop tiny separate parts (meshoptimizer)" Checked="OnPruneChanged" Unchecked="OnPruneChanged"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="Removes small loose pieces whose removal stays within the distance limit (bolts, emblems). Only with the meshoptimizer simplifier." />
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
