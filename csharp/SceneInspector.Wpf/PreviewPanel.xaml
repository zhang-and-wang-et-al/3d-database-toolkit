<UserControl x:Class="SceneInspector.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SceneInspector">
    <DockPanel>
        <!-- view options -->
        <WrapPanel x:Name="OptionBar" DockPanel.Dock="Top" Margin="10,4,10,6">
            <TextBlock Text="3D PREVIEW" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Border Style="{StaticResource SegmentBar}" Margin="0,0,8,4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ViewBefore" Style="{StaticResource Segment}" Content="Before" GroupName="view" Checked="OnOptionChanged"
                                 ToolTip="The geometry before the change" />
                    <RadioButton x:Name="ViewAfter" Style="{StaticResource Segment}" Content="After" GroupName="view" IsChecked="True" Checked="OnOptionChanged"
                                 ToolTip="The current geometry" />
                    <RadioButton x:Name="ViewSide" Style="{StaticResource Segment}" Content="Side by Side" GroupName="view" Checked="OnOptionChanged"
                                 ToolTip="Before on the left, after on the right, same camera" />
                </StackPanel>
            </Border>
            <ComboBox x:Name="ModeBox" Width="150" Margin="0,0,6,4" SelectedIndex="1" SelectionChanged="OnOptionChanged" ToolTip="Shading">
                <ComboBoxItem Content="Shaded" Tag="shaded" />
                <ComboBoxItem Content="Shaded + Wireframe" Tag="shaded + wireframe" />
                <ComboBoxItem Content="Wireframe" Tag="wireframe" />
            </ComboBox>
            <ComboBox x:Name="ColorBox" Width="160" Margin="0,0,10,4" SelectedIndex="0" SelectionChanged="OnOptionChanged" ToolTip="Colouring">
                <ComboBoxItem Content="Material" />
                <ComboBoxItem Content="Deviation Heat Map" ToolTip="Distance of the simplified surface to the original" />
                <ComboBoxItem Content="Textured" ToolTip="Textures as loaded. Magenta / black checker: texture file missing. Plain magenta: texture but no UVs." />
                <ComboBoxItem Content="UV Checker" ToolTip="A test grid on the UVs: stretched, squashed or torn cells show broken UVs. Red grows with u, green with v." />
            </ComboBox>
            <CheckBox x:Name="BackFaces" Content="Back faces red" IsChecked="True" Margin="0,0,10,4" VerticalAlignment="Center"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" ToolTip="Draw the back side of triangles red (flipped or one-sided faces)" />
            <CheckBox x:Name="WholeScene" Content="Scene around" IsChecked="True" Margin="0,0,10,4" VerticalAlignment="Center"
                      ToolTip="Show the rest of the scene in grey around the selected node (the selection in orange)"
                      Checked="OnWholeSceneChanged" Unchecked="OnWholeSceneChanged" />
            <Button Style="{StaticResource Button.Ghost}" local:Ui.Icon="&#xE80F;" Content="Reset View" Click="OnResetView" Margin="0,0,0,4"
                    ToolTip="Fit the camera to the object again" />
        </WrapPanel>

        <!-- simplify preview (bottom first so the view never pushes it out) -->
        <Border x:Name="TryStrip" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}" CornerRadius="5" Padding="12,9" Margin="10,6,10,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="SIMPLIFY PREVIEW" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  nothing changes until you apply" Style="{StaticResource Muted}" FontSize="{DynamicResource Font.Small}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button Content="Preview" local:Ui.Icon="&#xE7B3;" Click="OnTry" Margin="0,0,6,0" ToolTip="Simplify a copy and compare it with the original" />
                        <Button x:Name="ApplyButton" Style="{StaticResource Button.Accent}" Content="Apply to Scene" IsEnabled="False" Click="OnApply"
                                ToolTip="Run simplify with these settings on the node (undo with Ctrl+Z)" AutomationProperties.AutomationId="ApplyButton" />
                    </StackPanel>
                    <local:SimplifyEditor x:Name="TryEditor" AutomationProperties.AutomationId="TryEditor" ShowAutoTry="True" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Button x:Name="NextButton" DockPanel.Dock="Bottom" Style="{StaticResource Button.Accent}" Visibility="Collapsed" HorizontalAlignment="Left"
                Margin="10,6,10,0" Click="OnNext" AutomationProperties.AutomationId="NextButton"
                ToolTip="Change the setting and preview again" />
        <TextBlock x:Name="VerdictText" DockPanel.Dock="Bottom" FontWeight="SemiBold" TextWrapping="Wrap" Margin="10,4,10,0" />
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="10,6,10,0" Style="{StaticResource Muted}"
                   Text="Select a node in the tree. Drag = rotate, right-drag = move, wheel = zoom." />

        <!-- heat map legend: only in heat map mode -->
        <StackPanel x:Name="LegendBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,6,10,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ColorBox}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Distance to the original surface: red at" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBox x:Name="HeatMaxBox" Text="1.0" Width="52" Margin="6,0" KeyDown="OnHeatKey" LostFocus="OnOptionChanged"
                     ToolTip="Press Enter to apply" />
            <TextBlock Text="% of the object size" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <Border CornerRadius="2" ClipToBounds="True" Margin="10,0,6,0" VerticalAlignment="Center">
                <Image x:Name="Legend" Width="180" Height="10" Stretch="Fill" />
            </Border>
            <TextBlock x:Name="LegendMax" VerticalAlignment="Center" FontSize="{DynamicResource Font.Small}" Style="{StaticResource Muted}" />
        </StackPanel>

        <Border x:Name="ViewBorder" Background="{DynamicResource Viewport}" Margin="10,0" CornerRadius="4" ClipToBounds="True" SizeChanged="OnViewSize"
                MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel" Cursor="SizeAll">
            <Image x:Name="View" Stretch="Fill" />
        </Border>
    </DockPanel>
</UserControl>
